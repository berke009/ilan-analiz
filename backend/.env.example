# Backend'in varsayılan işi tektir: gizlilik politikası sayfasını sunmak. Analiz
# kullanıcının tarayıcısında, kendi API anahtarıyla üretiliyor; burada model,
# veritabanı, kota veya ödeme yapılandırması YOK.
#
# İkinci ve İSTEĞE BAĞLI iş: rıza veren kullanıcılar arasında paylaşılan analiz
# önbelleği. Aşağıdaki PAYLASIM_ACIK verilmedikçe o uçlar hiç kurulmaz.

# HTTP portu
PORT=3000
# Dinlenecek adres. Cloudflare Tunnel arkasında SADECE loopback dinlenmeli: dışarıya
# açık port olursa istemci cf-connecting-ip başlığını uydurup IP limitini atlar.
BIND=127.0.0.1

# Gizlilik sayfasında görünen veri sorumlusu bilgileri
ILETISIM_EPOSTA=
SIRKET_ADI=
SIRKET_YER=

# ─── Paylaşılan önbellek (isteğe bağlı) ────────────────────────────────────────
# 1 dışında bir değer / hiç verilmemesi = uçlar YOK. Depoyu klonlayıp hiçbir şey
# ayarlamadan çalıştıran biri, önbellek katmanı hiç yokmuş gibi bir sunucu alır.
PAYLASIM_ACIK=0

# Valkey (Redis'in BSD lisanslı forku, protokol uyumlu). Boş bırakılırsa bellek içi
# depo kullanılır: tek süreçlik küçük kurulum için yeterli, ama süreç yeniden
# başlayınca önbellek sıfırlanır ve birden fazla örnek çalıştırılamaz.
VALKEY_URL=redis://127.0.0.1:6379

# Kayıtların saklama süresi. Uzantının yerel önbelleğiyle AYNI olmalı (24 saat);
# ayrışırsa kullanıcı aynı ilanda bir gün eski bir gün yeni sonuç görür.
ONBELLEK_TTL_SN=86400

# İstemci IP'sini hangi başlıktan okuyacağımız. Yalnız KENDİ vekilinizin yazdığı bir
# başlık olmalı — sunucu doğrudan internete açıksa istemci bunu uydurup limiti atlar.
IP_BASLIGI=cf-connecting-ip

# Kök sayfadaki kaynak kodu bağlantısı. Kendi çatalınızı kuruyorsanız kendi deponuzu
# yazın: sayfanın "kodun tamamı burada" iddiası ancak gösterdiği depo çalışan koda
# denk düşüyorsa doğru olur.
DEPO_URL=https://github.com/berke009/ilan-analiz

# Uzantı kaynakları (chrome-extension:// ve moz-extension://) zaten kabul edilir.
# Buraya yalnız ek olarak izin vermek istediğiniz kaynakları virgülle yazın.
IZINLI_ORIGIN=

# Gövde boyutu tavanı. Şema alan alan zaten sınırlıyor; bu, ayrıştırıcıya hiç
# ulaşmadan devasa gövdeleri kesen kaba filtre.
GOVDE_SINIRI_BAYT=16384

# Hız limitleri. Okuma eşikleri İNSANI DEĞİL SALDIRIYI keser: kenar önbelleği
# okumaların büyük kısmını buraya hiç getirmiyor, meşru kullanıcıyı 429'lamanın
# bedeli ise kazandırdığı korumadan büyük. Yazma dar (her yazma bir yapay zekâ
# çağrısının ürünü; dakikada 30'un üstünü gören şey insan değildir).
LIMIT_OKUMA_DK=600
LIMIT_OKUMA_GUN=20000
LIMIT_YAZMA_DK=30
LIMIT_YAZMA_GUN=300
# IP limitleri BELİRGİN ŞEKİLDE geniş: Türkiye'de mobil operatörler CGNAT kullanıyor,
# binlerce gerçek kullanıcı tek IP'den gelebiliyor. Dar tutulursa meşru kitle kesilir.
LIMIT_OKUMA_IP_DK=6000
LIMIT_YAZMA_IP_DK=240
# Son emniyet supabı: kimlik ve IP çeşitlendiren dağıtık bir yazma seline karşı.
# Aşıldığında okuma çalışmaya devam eder.
LIMIT_YAZMA_GENEL_SAAT=20000

# Cloudflare Tunnel jetonu (Zero Trust → Networks → Tunnels). docker-compose bunu
# okuyor. Depoya ASLA girmez — .env gitignore'da.
CLOUDFLARE_TUNNEL_TOKEN=
